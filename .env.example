# Postgres (Vercel Postgres / Neon — set automatically if you use Vercel Postgres integration)
POSTGRES_URL=

# Session signing secret (any long random string)
SESSION_SECRET=change-this-to-a-long-random-string

# Public base URL of this deployment, no trailing slash (used to build Daraja callback URLs)
BASE_URL=https://your-app.vercel.app

# ---- Platform's OWN Daraja credentials ----
# These belong to YOU (the gateway operator). They are used ONLY to collect
# the KES 350 activation fee from developers when they link an account.
# Get these from https://developer.safaricom.co.ke (production app, not sandbox)
PLATFORM_CONSUMER_KEY=
PLATFORM_CONSUMER_SECRET=
PLATFORM_SHORTCODE=
PLATFORM_PASSKEY=
PLATFORM_ENV=sandbox
# sandbox shortcode 174379 + Safaricom's public sandbox passkey work for testing
